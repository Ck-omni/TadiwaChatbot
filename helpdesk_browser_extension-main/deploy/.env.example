# Copy to .env and edit. Used by docker-compose for the backend container.

# --- Database ---
# This backend shares its database with the Omni Helpdesk console
# (tadiwa-backend) — point this at the SAME Postgres instance and `tadiwa`
# database tadiwa-backend's own DATABASE_URL uses, not a database of its own.
DATABASE_URL=postgres://user:password@your-tadiwa-db-host:5432/tadiwa

# --- Your internal LLM ---
# custom_stream: an in-house wrapper taking POST {url} {"messages":[…]} and
# streaming `data: {"token": "…"}` (e.g. the Mistral-7B "LLM API Server").
# openai: a standard {base}/chat/completions endpoint (Ollama, vLLM, …).
LLM_CHAT_STYLE=custom_stream
LLM_CHAT_URL=http://your-llm-host:8000/api/v1/chat/stream
LLM_BASE_URL=http://your-llm-host:8000/api/v1      # unused when LLM_CHAT_URL is set
LLM_MODEL=mistral-7b                                # label only for custom_stream

# --- Embeddings (the LLM server has none — use the local Ollama container) ---
EMBED_BASE_URL=http://ollama:11434/v1
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768                 # MUST match the embedding model's dimension
LLM_API_KEY=local             # usually unused locally
# nomic-embed-text task prefixes (defaults shown). Set to "" for models that
# don't use them. Changing EMBED_DOC_PREFIX requires re-ingesting the guide.
# EMBED_QUERY_PREFIX=search_query:\x20
# EMBED_DOC_PREFIX=search_document:\x20

# --- Answering ---
# route: LLM reads the full ticket + candidates and picks the procedure (robust
#        to noisy tickets; needs a reasonably fast LLM). verbatim: top similarity
#        match, no LLM, instant (fast fallback).
ANSWER_MODE=route
# How many candidate procedures (ordered by similarity) the LLM chooses from.
# Bigger = better recall but a larger/slower prompt. For a small guide, ~all.
SELECT_CANDIDATES=5

# --- Retrieval tuning ---
# nomic similarities sit in a high, compressed band (~0.55-0.77), so the 0.35
# default lets unrelated tickets through. 0.68 was tuned with the retrieval-only
# eval (dev/eval/run_eval.py). The metric that matters end-to-end is
# `run_eval.py --route`, which exercises the real routing path incl. the LLM.
# Re-tune with the eval set if you change embedding models.
RAG_MIN_SIM=0.68
# RAG_TOP_K=4                  # results from the /api/retrieve debug endpoint

# --- Security (set these for production) ---
# Lock CORS to your real, pinned extension id (see DEPLOYMENT.md):
ALLOWED_ORIGINS=chrome-extension://REPLACE_WITH_EXTENSION_ID
SCRUB_PII=1                   # redact emails/phones/long digit runs
STORE_TICKET_TEXT=1           # keep scrubbed ticket text for gap-mining
