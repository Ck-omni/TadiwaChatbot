# Database configuration — the SAME database tadiwa-backend uses
# (tadiwa-backend/.env's DATABASE_URL), not a separate `copilot` database.
DATABASE_URL=postgres://postgres:2209@localhost:5432/tadiwa

# LLM configuration
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5-coder:7b-instruct

# Embeddings configuration
EMBED_BASE_URL=http://127.0.0.1:11434/v1
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Other settings
LLM_API_KEY=local
ALLOWED_ORIGINS=*


